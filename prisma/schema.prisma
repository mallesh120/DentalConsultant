generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ProcedureCache {
  id        String   @id @default(cuid())
  procedure String
  persona   String
  language  String
  response  Json
  createdAt DateTime @default(now())

  @@unique([procedure, persona, language])
}

model Feedback {
  id         String   @id @default(cuid())
  procedure  String
  persona    String
  language   String
  isPositive Boolean
  comment    String?
  createdAt  DateTime @default(now())
}
